# ---------------------------------------------------------------- Project data
# Datasets and model weights are downloaded by scripts/download_data.py
# (~190 MB) and must never be committed.
data/*
!data/.gitkeep
# interrupted downloads from scripts/download_data.py
*.part

# ---------------------------------------------------------------- Results
# Tables (csv/md/tex) and figures (png/pdf) ARE committed: they are the
# evidence cited in the report. Only heavy demo video output is excluded.
results/demo/*.mp4
results/demo/*.avi
