# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Virtual environment
.venv/

# macOS
.DS_Store

# Datasets and model weights: ~250 MB, fetched by scripts/download_data.py.
# Never committed; data/.gitkeep preserves the directory.
data/*
!data/.gitkeep

# Interrupted downloads
*.part

# LaTeX build products (the committed PDF is report/smart-surveillance-report.pdf)
report/build/
*.aux
*.bbl
*.blg
*.log
*.out
*.synctex.gz

# Loose PDFs dropped at the repo root (reference material, not project output)
/*.pdf

# Demo video output (regenerate with demo.py). The tables in results/tables
# and the figures in results/figures ARE tracked: they are the evidence the
# report cites, and the README embeds the figures.
results/demo/*.mp4
